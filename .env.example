# PostgreSQL local and Docker Compose
POSTGRES_PASSWORD=replace-with-a-strong-postgres-password
DATABASE_URL=postgresql://thanhhuongstore:replace-with-a-strong-postgres-password@localhost:5432/thanhhuongstore_db
DIRECT_URL=postgresql://thanhhuongstore:replace-with-a-strong-postgres-password@localhost:5432/thanhhuongstore_db

# Redis local and Docker Compose
REDIS_PASSWORD=replace-with-a-strong-redis-password
REDIS_URL=redis://:replace-with-a-strong-redis-password@localhost:6379

# Custom JWT authentication: use two different random secrets
JWT_SECRET=replace-with-a-long-random-access-token-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-refresh-token-secret
NEXT_PUBLIC_APP_URL=http://localhost:3000

# OAuth login providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:3000/api/auth/facebook/callback
OAUTH_SUCCESS_REDIRECT_URL=http://localhost:3000/account
OAUTH_FAILURE_REDIRECT_URL=http://localhost:3000/login

# Local seed admin account. Do not use real production passwords here.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-local-only
SEED_ADMIN_FIRST_NAME=Admin
SEED_ADMIN_LAST_NAME=User

# VNPay: configure sandbox values for local development
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:3000/api/payment/vnpay/return

# SMTP and email worker
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Thanh Huong Store <no-reply@example.com>
START_EMAIL_WORKER=false

# Optional bank transfer settings. NEXT_PUBLIC values are visible to clients.
NEXT_PUBLIC_BANK_ID=
NEXT_PUBLIC_BANK_ACCOUNT=
NEXT_PUBLIC_BANK_ACCOUNT_NAME=

# Optional runtime integrations
ANTHROPIC_API_KEY=
